{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "react-router-dom": ["./src/lib/router-shim.tsx"]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
