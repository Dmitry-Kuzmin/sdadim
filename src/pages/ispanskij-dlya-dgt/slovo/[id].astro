---
/**
 * Страница слова: перевод, толкование, картинка и главное — настоящие вопросы DGT с этим словом,
 * на которые можно ответить: так видно, зачем слово знать. Дальше ловушка, тренировка и похожие слова.
 * Нет вопросов с ответами — пример из вопроса и мини-тест на соседнем слове. Страница есть только у hasPage.
 */
import Base from "@/layouts/Base.astro";
import Trainer from "@/components/words/Trainer.astro";
import Crumbs from "@/components/words/Crumbs.astro";
import { BASE, PAGE_WORDS, WORDS, cap, plural, qImg, rank, related, setUrl, wordImg, wordQuestions, wordSet, wordUrl, type Word } from "@/lib/words";
import { findIn, similar } from "@/components/words/engine";
import { wordSeo } from "@/lib/seo";

export function getStaticPaths() {
  return PAGE_WORDS.map((w) => ({ params: { id: w.id }, props: { w } }));
}

const { w } = Astro.props as { w: Word };
const set = wordSet(w);
const near = related(w);
const at = PAGE_WORDS.indexOf(w);
const prev = PAGE_WORDS[at - 1];
const next = PAGE_WORDS[at + 1];
const hit = w.ex ? findIn(w.ex.es, w.es) : null;
const qs = wordQuestions(w);
/** Вопрос по частям: слово подсвечено. */
const parts = (es: string) => {
  const m = findIn(es, w.es);
  return m ? [es.slice(0, m[0]), es.slice(m[0], m[1]), es.slice(m[1])] : [es, "", ""];
};
/** Объяснение SkilyApp «🎓 правило 🇷🇺 как в России 💡 запоминалка» → три части; markdown-звёздочки убираем. */
const explain = (x = "") => {
  const [main, ...more] = x.replace(/\*\*/g, "").replace(/\s+/g, " ").trim().replace(/^🎓\s*/u, "").split(/\s*(?=🇷🇺|💡)/u);
  const tail = (k: string) => more.find((m) => m.startsWith(k))?.slice(k.length).trim();
  return { main: main.trim(), ru: tail("🇷🇺"), tip: tail("💡") };
};

// Мини-тест — на соседнем слове: проверка, а не повтор того, что написано выше. Неверные варианты — ближайшие
// по частоте слова той же темы без синонимов: без случайности, HTML не меняется от сборки к сборке.
const quiz = qs.length ? undefined : near[0];
const wrong: Word[] = [];
for (const x of quiz ? related(quiz, 30) : []) {
  if (wrong.length >= 3) break;
  if (x.id !== w.id && !similar(x.ru, quiz!.ru) && !wrong.some((y) => similar(y.ru, x.ru))) wrong.push(x);
}
const opts = quiz && wrong.length === 3 ? [quiz, ...wrong].sort((a, b) => a.ru.localeCompare(b.ru, "ru")) : [];
---

<Base seo={wordSeo(w)}>
  <Trainer />
  <main class="mx-auto max-w-4xl px-4 pb-24 pt-8 sm:px-6 md:pt-10">
    <Crumbs items={[{ name: "Главная", href: "/" }, { name: "Испанский для DGT", href: BASE }, { name: set.short, href: setUrl(set) }, { name: w.es }]} />

    <article>
      <header class="grid gap-6 sm:grid-cols-[1fr_auto] sm:items-start">
        <div>
          <p class="text-sm font-semibold text-blue-600">{set.emoji} {set.short}</p>
          <h1 class="mt-2 flex flex-wrap items-center gap-3 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
            {w.es}
            <button type="button" data-say={w.es} class="rounded-xl bg-blue-50 px-2.5 py-1.5 text-2xl leading-none hover:bg-blue-100" aria-label={`Произнести ${w.es}`}>🔊</button>
          </h1>
          <p class="mt-3 text-2xl font-semibold text-blue-700">{w.ru}</p>
          {w.d && <p class="mt-3 max-w-xl text-lg leading-relaxed text-slate-600">{w.d}</p>}
          <p class="mt-4 flex flex-wrap gap-2 text-sm">
            {w.q > 0 && <span class="rounded-full bg-amber-50 px-3 py-1 font-semibold text-amber-800">Встречается в {plural(w.q, "вопросе", "вопросах", "вопросах")} экзамена</span>}
            {w.q > 0 && <span class="rounded-full bg-slate-100 px-3 py-1 font-medium text-slate-600">№{rank(w)} по частоте из {WORDS.length}</span>}
          </p>
        </div>
        {
          w.img && (
            <img
              src={wordImg(w.id)}
              alt={`${w.es} — ${w.ru}`}
              width="640"
              height="480"
              fetchpriority="high"
              class={`w-full rounded-2xl sm:w-80 ${w.img === "sign" ? "aspect-square max-w-[220px] bg-white object-contain p-4 ring-1 ring-slate-200" : "aspect-[4/3] object-cover"}`}
            />
          )
        }
      </header>

      {
        qs.length > 0 ? (
          <section class="mt-12" aria-labelledby="exam">
            <h2 id="exam" class="text-xl font-bold text-slate-900">«{w.es}» в {qs.length > 1 ? "вопросах" : "вопросе"} экзамена</h2>
            <p class="mt-1 text-slate-500">Ответьте — покажем перевод и объяснение.</p>
            <ol class="mt-5 space-y-6">
              {qs.map((q, i) => {
                const [a, b, c] = parts(q.es);
                const x = explain(q.x);
                return (
                  <li class="xq p-4 sm:p-5" data-xq>
                    <div class:list={["grid gap-4 sm:gap-5", q.img && "md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]"]}>
                    {q.img && (
                      <img src={qImg(q.id)} alt="" width={q.img[0]} height={q.img[1]} loading={i ? "lazy" : "eager"} decoding="async" class="block w-full rounded-xl bg-slate-100" />
                    )}
                    <div>
                      <p class="flex items-center gap-2 text-xs font-semibold text-slate-500">
                        {qs.length > 1 && <span>Вопрос {i + 1} из {qs.length}</span>}
                        <span class="xq-res" data-xq-res aria-live="polite" />
                      </p>
                      <p class="mt-1.5 text-[17px] font-semibold leading-snug text-slate-900" lang="es">
                        {a}{b && <mark class="rounded bg-yellow-200/80 px-0.5 text-inherit">{b}</mark>}{c}
                      </p>
                      <div class="xq-ru"><p class="pt-1 text-[15px] text-slate-500">{q.ru}</p></div>
                      <div class="mt-4 grid gap-2">
                        {q.a.map((o, j) => (
                          <button type="button" class="xq-opt" data-ok={o.ok ? "1" : undefined}>
                            <span class="xq-key">{"abcd"[j]}</span>
                            <span class="min-w-0">
                              <span class="block text-slate-800" lang="es">{o.es}</span>
                              <span class="xq-ru"><span class="block pt-0.5 text-sm text-slate-500">{o.ru}</span></span>
                            </span>
                          </button>
                        ))}
                      </div>
                    </div>
                    </div>
                      {x.main && (
                        <div class="xq-ru">
                          <div class="mt-4 space-y-2 rounded-xl bg-slate-50 p-4 text-[15px] leading-relaxed text-slate-700">
                            <p>{x.main}</p>
                            {x.tip && <p class="font-semibold text-blue-700">💡 {x.tip}</p>}
                            {x.ru && <p class="text-sm text-slate-500">🇷🇺 {x.ru}</p>}
                          </div>
                        </div>
                      )}
                  </li>
                );
              })}
            </ol>
          </section>
        ) : (
          w.ex && (
            <section class="mt-10" aria-labelledby="exam">
              <h2 id="exam" class="text-xl font-bold text-slate-900">«{w.es}» в вопросе экзамена DGT</h2>
              <figure class="mt-4 rounded-2xl border-l-4 border-blue-600 bg-slate-50 p-5">
                <blockquote class="text-lg font-medium leading-relaxed text-slate-900" lang="es">
                  {hit ? (
                    <>
                      {w.ex.es.slice(0, hit[0])}
                      <mark class="rounded bg-yellow-200 px-0.5 text-slate-900">{w.ex.es.slice(hit[0], hit[1])}</mark>
                      {w.ex.es.slice(hit[1])}
                    </>
                  ) : (
                    w.ex.es
                  )}
                </blockquote>
                <figcaption class="mt-2 text-slate-600">{w.ex.ru}</figcaption>
              </figure>
            </section>
          )
        )
      }

      {
        w.h && (
          <aside class="mt-6 rounded-2xl bg-amber-50 p-5 text-amber-900">
            <p class="font-bold">💡 Обратите внимание</p>
            <p class="mt-1 leading-relaxed">{w.h}</p>
          </aside>
        )
      }

      <section class="mt-10 rounded-3xl bg-blue-600 p-6 text-white sm:p-8">
        <h2 class="text-xl font-bold">Запомните «{w.es}» за 5 минут</h2>
        <p class="mt-1 text-[#fff]/85">Тренировка дня по теме «{set.short}»: картинка, слух, сборка по буквам и пропуск в вопросе. Слово вернётся на повторение, когда начнёте его забывать.</p>
        <div class="mt-5 flex flex-wrap gap-2">
          <button type="button" data-play="daily" data-module={set.module} class="rounded-xl bg-[#fff] px-5 py-3 font-bold text-[#1d4ed8]">🎯 Учить тему</button>
          <button type="button" data-play="road" data-module={set.module} class="rounded-xl bg-[#fff]/15 px-5 py-3 font-bold text-white hover:bg-[#fff]/25">🏁 Трасса</button>
          <button type="button" data-play="radar" data-module={set.module} class="rounded-xl bg-[#fff]/15 px-5 py-3 font-bold text-white hover:bg-[#fff]/25">📡 Радар</button>
        </div>
      </section>

      {
        quiz && opts.length > 0 && (
          <section class="mt-12" aria-labelledby="quiz">
            <h2 id="quiz" class="text-xl font-bold text-slate-900">Проверьте себя: что значит «{quiz.es}»?</h2>
            <div class="xq mt-4 p-5 sm:p-6" data-xq>
              <div class="grid gap-2 sm:grid-cols-2">
                {opts.map((o, j) => (
                  <button type="button" class="xq-opt" data-ok={o.id === quiz.id ? "1" : undefined}>
                    <span class="xq-key">{"abcd"[j]}</span>
                    <span class="text-slate-800">{o.ru}</span>
                  </button>
                ))}
              </div>
              <div class="xq-ru">
                <p class="pt-3 text-sm"><a href={wordUrl(quiz)} class="font-semibold text-blue-700">Подробнее о «{quiz.es}» →</a></p>
              </div>
            </div>
          </section>
        )
      }

      {
        near.length > 0 && (
          <section class="mt-12" aria-labelledby="near">
            <h2 id="near" class="mb-4 text-xl font-bold text-slate-900">Похожие слова из темы «{set.short}»</h2>
            <ul class="grid gap-2 sm:grid-cols-2">
              {near.map((x) => (
                <li>
                  <a href={wordUrl(x)} class="flex items-baseline justify-between gap-3 rounded-xl border border-slate-200 px-4 py-3 hover:border-blue-300">
                    <span class="font-bold text-slate-900">{x.es}</span>
                    <span class="truncate text-sm text-slate-500">{x.ru}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href={setUrl(set)} class="mt-4 inline-flex font-semibold text-blue-700">Все слова темы «{set.short}» →</a>
          </section>
        )
      }

      <nav class="mt-12 flex justify-between gap-4 border-t border-slate-200 pt-6 text-sm" aria-label="Соседние слова">
        {prev ? <a href={wordUrl(prev)} class="text-slate-600 hover:text-blue-700">← {cap(prev.es)}</a> : <span />}
        {next && <a href={wordUrl(next)} class="text-right text-slate-600 hover:text-blue-700">{cap(next.es)} →</a>}
      </nav>
    </article>
  </main>
</Base>

<script>
  // Вопрос: верный вариант — зелёная галочка, неверный — красный крестик с покачиванием; затем плавно
  // раскрываются перевод и объяснение (у мини-теста — ссылка на слово).
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const play = (el: Element | null, cls: string) => {
    if (!el || still) return;
    el.classList.remove(cls);
    void (el as HTMLElement).offsetWidth;
    el.classList.add(cls);
  };
  document.querySelectorAll<HTMLElement>("[data-xq]").forEach((q) => {
    const btns = [...q.querySelectorAll<HTMLButtonElement>(".xq-opt")];
    btns.forEach((b) =>
      b.addEventListener("click", () => {
        if (q.classList.contains("is-done")) return;
        q.classList.add("is-done");
        const ok = btns.find((x) => x.dataset.ok)!;
        btns.forEach((x) => (x.disabled = true));
        ok.classList.add("is-ok");
        ok.querySelector(".xq-key")!.textContent = "✓";
        play(ok.querySelector(".xq-key"), "xq-pop");
        if (b !== ok) {
          b.classList.add("is-bad");
          b.querySelector(".xq-key")!.textContent = "✕";
          play(b, "xq-shake");
        }
        const res = q.querySelector<HTMLElement>("[data-xq-res]");
        if (res) {
          res.textContent = b === ok ? "Верно" : "Ошибка";
          res.classList.add(b === ok ? "is-ok" : "is-bad");
          play(res, "xq-pop");
        }
      }),
    );
  });
</script>

<style>
  /* Карточка — как у виджетов статей (widgets/Shell.astro): тонкая рамка и мягкая тень */
  .xq {
    overflow: clip;
    border-radius: 1rem;
    border: 1px solid rgb(var(--c-slate-200));
    background: rgb(var(--surface));
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.04), 0 18px 40px -24px rgb(15 23 42 / 0.22);
  }
  .xq-opt {
    display: flex;
    width: 100%;
    align-items: flex-start;
    gap: 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(var(--c-slate-200));
    background: rgb(var(--surface));
    padding: 0.7rem 0.85rem;
    text-align: left;
    line-height: 1.4;
    transition: border-color 0.15s, background 0.15s, box-shadow 0.15s, transform 0.15s, opacity 0.25s;
    -webkit-tap-highlight-color: transparent;
  }
  .xq:not(.is-done) .xq-opt:hover { border-color: rgb(var(--c-blue-300)); box-shadow: 0 6px 16px -10px rgb(37 99 235 / 0.45); transform: translateY(-1px); }
  .xq:not(.is-done) .xq-opt:active { transform: scale(0.99); }
  .xq-opt:focus-visible { outline: 2px solid rgb(var(--c-blue-500) / 0.5); outline-offset: 2px; }
  .xq-key {
    display: grid;
    width: 1.375rem;
    height: 1.375rem;
    flex: none;
    place-items: center;
    margin-top: 0.05rem;
    border-radius: 999px;
    background: rgb(var(--c-slate-100));
    color: rgb(var(--c-slate-500));
    font-size: 0.75rem;
    font-weight: 700;
    transition: background 0.2s, color 0.2s;
  }
  .xq-opt.is-ok { border-color: rgb(var(--c-emerald-500)); background: rgb(var(--c-emerald-500) / 0.08); }
  .xq-opt.is-ok .xq-key { background: rgb(var(--c-emerald-500)); color: #fff; }
  .xq-opt.is-bad { border-color: rgb(var(--c-rose-400)); background: rgb(var(--c-rose-500) / 0.07); }
  .xq-opt.is-bad .xq-key { background: rgb(var(--c-rose-500)); color: #fff; }
  .is-done .xq-opt { cursor: default; }
  .is-done .xq-opt:not(.is-ok):not(.is-bad) { opacity: 0.55; }

  .xq-res { border-radius: 999px; padding: 0.1rem 0.55rem; }
  .xq-res:empty { display: none; }
  .xq-res.is-ok { background: rgb(var(--c-emerald-500) / 0.12); color: rgb(var(--c-emerald-700)); }
  .xq-res.is-bad { background: rgb(var(--c-rose-500) / 0.12); color: rgb(var(--c-rose-700)); }

  /* Перевод и объяснение: в HTML с самого начала (их видит поиск), раскрываются плавно по высоте */
  .xq-ru { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 0.35s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 0.3s; }
  .xq-ru > * { overflow: hidden; min-height: 0; }
  .is-done .xq-ru { grid-template-rows: 1fr; opacity: 1; }

  .xq-pop { animation: xq-pop 0.38s cubic-bezier(0.3, 1.5, 0.5, 1); }
  @keyframes xq-pop { 40% { transform: scale(1.2); } }
  .xq-shake { animation: xq-shake 0.4s; }
  @keyframes xq-shake { 20%, 60% { transform: translateX(-3px); } 40%, 80% { transform: translateX(3px); } }
  @media (prefers-reduced-motion: reduce) {
    .xq-opt, .xq-ru { transition: none; }
  }
</style>
