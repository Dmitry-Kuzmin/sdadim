---
/**
 * Главная: статичный HTML + маленькие скрипты, без фреймворков.
 * Интерактив — вопрос DGT в hero, квиз-калькулятор, тарифы, FAQ — ванильный TS в своих компонентах.
 */
import Base from "@/layouts/Base.astro";
import { HOME_SEO } from "@/lib/seo";
import Hero from "@/components/home/Hero.astro";
import HowItWorks from "@/components/home/HowItWorks.astro";
import Included from "@/components/home/Included.astro";
import Pricing from "@/components/home/Pricing.astro";
import Testimonials from "@/components/home/Testimonials.astro";
import Faq from "@/components/home/Faq.astro";
import HomeBlog from "@/components/home/HomeBlog.astro";
import FinalCta from "@/components/home/FinalCta.astro";
import StickyBar from "@/components/home/StickyBar.astro";
---

<Base seo={HOME_SEO}>
  <div class="bg-white text-slate-900">
    <main>
      <Hero />
      <HowItWorks />
      <Included />
      <Pricing />
      <Testimonials />
      <Faq />
      <HomeBlog />
      <FinalCta />
    </main>
    <StickyBar />
  </div>
</Base>

<script>
  import { loadStreams } from "@/lib/course-data";
  import { botLink, QUIZ_EVENT } from "@/lib/home-links";
  import { openStreams, startLine } from "@/lib/streams";

  // Финальный блок: дата ближайшего старта
  loadStreams().then((streams) => {
    const next = openStreams(streams)[0];
    const el = document.querySelector("[data-next-start]");
    if (next && el) el.textContent = `${startLine(next)}.`;
  });

  // Калькулятор пройден — код ответов во все ссылки в бот
  addEventListener(QUIZ_EVENT, (e) => {
    const code = (e as CustomEvent<string>).detail;
    document.querySelectorAll<HTMLAnchorElement>("a[data-bot-param]").forEach((a) => (a.href = botLink(a.dataset.botParam!, code)));
  });

  // Чат Crisp — только на главной и только после первого действия посетителя (см. Base.astro)
  const loadCrisp = () => {
    if (document.getElementById("crisp-chat-script")) return;
    Object.assign(window, { $crisp: [], CRISP_WEBSITE_ID: "f75e4c12-7db0-4f2f-90fb-711aacc45df3" });
    const s = document.createElement("script");
    s.id = "crisp-chat-script";
    s.src = "https://client.crisp.chat/l.js";
    s.async = true;
    document.head.appendChild(s);
  };
  const w = window as Window & { onFirstInteraction?: (fn: () => void) => void };
  (w.onFirstInteraction ?? ((fn: () => void) => fn()))(loadCrisp);
</script>
