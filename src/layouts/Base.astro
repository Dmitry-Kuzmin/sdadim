---
import "@/index.css";
import Header from "@/components/layout/Header";
import Footer from "@/components/layout/Footer";
import { DEFAULT_OG_IMAGE, SITE_NAME, type PageSeo } from "@/lib/seo";

interface Props {
  seo: PageSeo;
}

const { seo } = Astro.props;
const ogImage = seo.ogImage ?? DEFAULT_OG_IMAGE;
const ogTitle = seo.ogTitle ?? seo.title;
const ogDescription = seo.ogDescription ?? seo.description;
const FONTS = "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Тема до первой отрисовки: сохранённый выбор, иначе системная
      (function () {
        try {
          var t = localStorage.getItem("theme");
          var dark = t ? t === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
          document.querySelector('meta[name="theme-color"]').setAttribute("content", dark ? "#0a0e16" : "#ffffff");
        } catch (e) {}
      })();
    </script>

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content={seo.ogType ?? "website"} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1000" />
    {seo.article && <meta property="article:published_time" content={seo.article.publishedTime} />}
    {seo.article && <meta property="article:modified_time" content={seo.article.modifiedTime} />}
    {seo.article && <meta property="article:section" content={seo.article.section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon-s.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Блог Сдадим" href="/rss.xml" />
    <meta name="google-site-verification" content="y3ZuWwlxngRU8JRF2t3nNsQTVMN0Aioto91zqB9UZO0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FONTS} /></noscript>

    {(seo.jsonLd ?? []).map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

    <!-- Yandex.Metrika counter -->
    <script is:inline>
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
        (k = e.createElement(t)), (a = e.getElementsByTagName(t)[0]), (k.async = 1), (k.src = r), a.parentNode.insertBefore(k, a);
      })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js?id=108379913", "ym");
      ym(108379913, "init", { ssr: true, webvisor: true, trackHash: true, clickmap: true, ecommerce: "dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce: true, trackLinks: true });
    </script>
    <!-- /Yandex.Metrika counter -->
  </head>
  <body>
    <noscript><div><img src="https://mc.yandex.ru/watch/108379913" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <Header client:load currentPath={Astro.url.pathname} />
    <slot />
    <Footer />
  </body>
</html>
