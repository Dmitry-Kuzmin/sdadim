---
import { ArrowUpRight } from "@lucide/astro";

const COLUMNS = [
  {
    title: "Курс",
    links: [
      { href: "/#how", label: "Как проходит" },
      { href: "/#pricing", label: "Цены" },
      { href: "/#faq", label: "Вопросы" },
      { href: "/ispanskij-dlya-dgt", label: "Испанский для DGT" },
      { href: "/blog", label: "Блог" },
    ],
  },
  {
    title: "Документы",
    links: [
      { href: "/legal/terms", label: "Оферта" },
      { href: "/legal/privacy", label: "Конфиденциальность" },
      { href: "/legal/cookies", label: "Cookies" },
      { href: "/legal/refund", label: "Возврат" },
    ],
  },
];
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5">
          <img src="/logo.svg" alt="" width="32" height="32" class="h-8 w-8 rounded-[22%]" />
          <span class="text-[17px] font-semibold tracking-tight text-slate-900">Sdadim</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-slate-500">Онлайн-подготовка к теоретическому экзамену DGT на русском языке. Проект Skilyapp.</p>
        <a href="mailto:support@skilyapp.com" class="mt-4 inline-block text-sm font-medium text-slate-700 hover:text-slate-900">support@skilyapp.com</a>
      </div>

      {
        COLUMNS.map((col) => (
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-400">{col.title}</p>
            <ul class="mt-4 space-y-3">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="text-sm text-slate-600 transition-colors hover:text-slate-900">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col-reverse gap-4 border-t border-slate-200 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-slate-400">© {new Date().getFullYear()} Sdadim.eu · Не является автошколой и не выдаёт документы DGT</p>
      <a href="https://www.nrtv.studio" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 text-xs text-slate-400 transition-colors hover:text-slate-700">
        <img src="/nrtv-logo.png" alt="" width="20" height="20" class="h-5 w-5 rounded bg-[#0f172a] p-0.5" />
        Сайт сделан в NRTV
        <ArrowUpRight class="h-3 w-3" />
      </a>
    </div>
  </div>
</footer>
