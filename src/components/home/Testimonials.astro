---
/**
 * Отзывы: бесконечные колонки на чистом CSS (animate-marquee-up), без JS.
 * Для бесшовной петли контент дублируется ровно один раз, а gap равен pb.
 */
import { TESTIMONIALS } from "@/data/home/content";
import SectionHead from "./SectionHead.astro";

const COLUMNS = [
  { items: TESTIMONIALS.slice(0, 3), duration: 28, class: "" },
  { items: TESTIMONIALS.slice(3, 6), duration: 34, class: "hidden md:block" },
  { items: TESTIMONIALS.slice(6, 9), duration: 24, class: "hidden lg:block" },
];
---

<section class="cv-auto border-t border-slate-100 bg-slate-50/60 py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHead index="05" eyebrow="Отзывы" title="Уже сдали с нами" desc="Барселона, Мадрид, Малага, Бильбао — разный возраст и уровень испанского." />
    <div class="grid max-h-[640px] grid-cols-1 gap-4 overflow-hidden [mask-image:linear-gradient(to_bottom,transparent,black_12%,black_88%,transparent)] md:grid-cols-2 lg:grid-cols-3">
      {
        COLUMNS.map((col) => (
          <div class={`overflow-hidden ${col.class}`}>
            <div class="flex animate-marquee-up flex-col gap-4 pb-4" style={`--marquee-duration: ${col.duration}s`}>
              {[0, 1].map((copy) =>
                col.items.map(({ text, image, name, role }) => (
                  <figure aria-hidden={copy === 1 ? "true" : undefined} class="w-full rounded-3xl border border-slate-200 bg-white p-6 sm:p-7">
                    <blockquote class="text-[15px] leading-relaxed text-slate-700">{text}</blockquote>
                    <figcaption class="mt-5 flex items-center gap-3">
                      {image ? (
                        <img src={image} alt="" width="36" height="36" class="h-9 w-9 shrink-0 rounded-full object-cover" />
                      ) : (
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-600">{name[0]}</span>
                      )}
                      <span class="min-w-0">
                        <span class="block truncate text-sm font-semibold text-slate-900">{name}</span>
                        <span class="block truncate text-xs text-slate-500">{role}</span>
                      </span>
                    </figcaption>
                  </figure>
                ))
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
