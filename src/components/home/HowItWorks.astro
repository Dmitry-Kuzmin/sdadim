---
import { STEPS } from "@/data/home/content";
import { cn } from "@/lib/utils";
import SectionHead from "./SectionHead.astro";
---

<section id="how" class="cv-auto scroll-mt-16 border-t border-slate-100 bg-slate-50/60 py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHead index="01" eyebrow="Как проходит" title="Четыре шага до испанских прав" desc="Мы готовим к теории и ведём по документам. Практику вы проходите в местной автошколе." />
    <ol class="relative grid gap-0 lg:grid-cols-4 lg:gap-4">
      <!-- линия-таймлайн: вертикальная на мобиле, горизонтальная на десктопе -->
      <div aria-hidden="true" class="absolute bottom-8 left-[19px] top-8 w-px bg-slate-200 lg:hidden"></div>
      <div aria-hidden="true" class="absolute left-8 right-8 top-[19px] hidden h-px bg-slate-200 lg:block"></div>
      {
        STEPS.map((s, i) => (
          <li class="relative flex gap-5 pb-8 last:pb-0 lg:block lg:pb-0">
            <span
              class={cn(
                "relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border text-sm font-semibold tabular-nums",
                s.ours ? "border-blue-600 bg-blue-600 text-white" : "border-slate-200 bg-white text-slate-500"
              )}
            >
              {i + 1}
            </span>
            <div class="lg:mt-6 lg:pr-4">
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                <h3 class="text-[17px] font-semibold text-slate-900">{s.title}</h3>
                {s.ours && <span class="rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700">с нами</span>}
              </div>
              <p class="mt-1 text-sm font-medium text-slate-400">{s.time}</p>
              <p class="mt-2 text-[15px] leading-relaxed text-slate-600">{s.desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
