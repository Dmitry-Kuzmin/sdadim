---
/** Пример вопроса DGT в hero: варианты — кнопки, разбор подставляет маленький скрипт */
import { Check, Languages, Timer } from "@lucide/astro";

const OPTIONS = ["Los vehículos que ya circulan por la glorieta", "Los vehículos que quieren entrar en la glorieta", "El vehículo que llega por la derecha"];
const CORRECT = 0;
---

<div data-exam-q data-correct={CORRECT} class="relative mx-auto w-full max-w-[520px] lg:mx-0">
  <div aria-hidden="true" class="absolute inset-x-6 -bottom-3 top-3 rounded-3xl border border-slate-200 bg-white/70"></div>
  <div aria-hidden="true" class="absolute inset-x-12 -bottom-6 top-6 rounded-3xl border border-slate-200 bg-white/40"></div>

  <div class="relative rounded-3xl border border-slate-200 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04),0_32px_64px_-32px_rgba(15,23,42,0.25)] sm:p-7">
    <div class="flex items-center justify-between text-xs font-medium text-slate-500">
      <span class="tabular-nums">Вопрос 12 / 30</span>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 tabular-nums">
        <Timer class="h-3.5 w-3.5" /> 18:42
      </span>
    </div>
    <div class="mt-3 h-1 overflow-hidden rounded-full bg-slate-100">
      <div class="h-full w-[40%] rounded-full bg-slate-900"></div>
    </div>

    <p class="mt-6 text-lg font-semibold leading-snug text-slate-900 sm:text-xl">En una glorieta, ¿quién tiene prioridad de paso?</p>
    <p class="mt-2 flex items-center gap-2 text-sm text-slate-500">
      <Languages class="h-4 w-4 shrink-0 text-blue-600" />
      На круговом движении — у кого приоритет?
    </p>

    <div class="mt-5 space-y-2">
      {
        OPTIONS.map((opt, i) => (
          <button type="button" data-opt={i} data-state="idle" class="eq-opt flex w-full items-center gap-3 rounded-xl border px-3.5 py-3 text-left text-sm transition-colors sm:px-4">
            <span class="eq-badge flex h-6 w-6 shrink-0 items-center justify-center rounded-md border text-xs font-semibold">
              <span class="eq-letter">{String.fromCharCode(65 + i)}</span>
              <Check class="eq-check h-3.5 w-3.5" stroke-width={3} />
            </span>
            {opt}
          </button>
        ))
      }
    </div>

    <div class="mt-4 min-h-[44px] text-sm leading-relaxed">
      <p data-hint class="text-slate-400">Попробуйте ответить ↑</p>
      <p data-answer hidden class="text-slate-600">
        <span data-verdict class="font-semibold text-slate-900"></span>Приоритет у тех, кто уже едет по кругу. На уроке разбираем, почему — и где тут ловушка.
      </p>
    </div>
  </div>
</div>

<style>
  .eq-opt[data-state="idle"] { @apply border-slate-200 text-slate-700 hover:border-slate-300 hover:bg-slate-50; }
  .eq-opt[data-state="correct"] { @apply border-emerald-300 bg-emerald-50 text-emerald-950; }
  .eq-opt[data-state="wrong"] { @apply border-rose-300 bg-rose-50 text-rose-950; }
  .eq-opt .eq-badge { @apply border-slate-200 bg-slate-50 text-slate-500; }
  .eq-opt[data-state="correct"] .eq-badge { @apply border-emerald-500 bg-emerald-500 text-white; }
  .eq-check { display: none; }
  .eq-opt[data-state="correct"] .eq-check { display: block; }
  .eq-opt[data-state="correct"] .eq-letter { display: none; }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-exam-q]");
  if (root) {
    const correct = Number(root.dataset.correct);
    const opts = [...root.querySelectorAll<HTMLButtonElement>("[data-opt]")];
    opts.forEach((b, i) =>
      b.addEventListener("click", () => {
        opts.forEach((o, j) => (o.dataset.state = j === correct ? "correct" : j === i ? "wrong" : "idle"));
        root.querySelector<HTMLElement>("[data-hint]")!.hidden = true;
        root.querySelector<HTMLElement>("[data-answer]")!.hidden = false;
        root.querySelector("[data-verdict]")!.textContent = i === correct ? "Верно. " : "Не совсем. ";
      })
    );
  }
</script>
