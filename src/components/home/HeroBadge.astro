---
/** Плашка ближайшего потока в hero: данные из Supabase подставляет маленький скрипт, без React */
import { ArrowRight } from "@lucide/astro";
---

<a
  data-hero-badge
  href="#pricing"
  hidden
  class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 py-1 pl-1 pr-3 text-[13px] font-medium text-slate-700 shadow-sm backdrop-blur transition-colors hover:border-slate-300"
>
  <span data-number class="rounded-full bg-blue-600 px-2 py-0.5 text-xs font-semibold text-white"></span>
  <span data-line></span>
  <ArrowRight class="h-3.5 w-3.5 text-slate-400" />
</a>

<script>
  import { loadStreams } from "@/lib/course-data";
  import { openStreams, startLine } from "@/lib/streams";

  loadStreams().then((streams) => {
    const next = openStreams(streams)[0];
    const badge = document.querySelector<HTMLElement>("[data-hero-badge]");
    if (!next || !badge) return;
    badge.querySelector("[data-number]")!.textContent = `Поток ${next.number}`;
    badge.querySelector("[data-line]")!.textContent = startLine(next);
    badge.hidden = false;
  });
</script>
