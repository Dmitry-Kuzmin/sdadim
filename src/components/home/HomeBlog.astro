---
import { ArrowRight } from "@lucide/astro";
import { getPosts, postUrl, cardTitle } from "@/lib/blog";
import { coverSrcSet } from "@/lib/covers";
import SectionHead from "./SectionHead.astro";

const posts = (await getPosts()).slice(0, 3);
---

<section class="cv-auto border-t border-slate-100 py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex items-end justify-between gap-6">
      <SectionHead index="07" eyebrow="Блог" title="Полезно почитать" />
      <a href="/blog" class="mb-14 hidden shrink-0 items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-700 sm:inline-flex">
        Все статьи <ArrowRight class="h-4 w-4" />
      </a>
    </div>
    <div class="grid gap-8 md:grid-cols-3 md:gap-6">
      {
        posts.map((post) => (
          <a href={postUrl(post)} class="group">
            <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-slate-100 ring-1 ring-slate-200/60">
              <img
                src={post.data.cover}
                srcset={coverSrcSet(post.data.cover)}
                sizes="(min-width: 768px) 360px, 100vw"
                alt=""
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <p class="mt-4 text-xs font-medium text-slate-500">
              {post.data.category} · {post.data.readingTime} мин
            </p>
            <h3 class="mt-2 font-semibold leading-snug text-slate-900 transition-colors group-hover:text-blue-600">{cardTitle(post)}</h3>
          </a>
        ))
      }
    </div>
    <a href="/blog" class="mt-8 inline-flex items-center gap-1 text-sm font-medium text-blue-600 sm:hidden">
      Все статьи <ArrowRight class="h-4 w-4" />
    </a>
  </div>
</section>
