---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  desc?: string;
}

const { index, eyebrow, title, desc } = Astro.props;
---

<div class="mb-10 max-w-2xl md:mb-14">
  <p class="flex items-center gap-3 text-sm font-medium text-slate-500">
    <span class="tabular-nums text-blue-600">{index}</span>
    <span class="h-px w-6 bg-slate-300"></span>
    {eyebrow}
  </p>
  <h2 class="mt-4 text-[1.75rem] font-semibold leading-[1.15] tracking-tight text-slate-900 sm:text-4xl text-balance">{title}</h2>
  {desc && <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg text-pretty">{desc}</p>}
</div>
