---
import { INCLUDED } from "@/data/home/content";
import SectionHead from "./SectionHead.astro";
---

<section class="cv-auto py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHead index="02" eyebrow="Что входит" title="Всё для экзамена — в одном месте" />
    <div class="grid gap-px overflow-hidden rounded-3xl border border-slate-200 bg-slate-200 sm:grid-cols-2 lg:grid-cols-3">
      {
        INCLUDED.map((f) => (
          <div class="bg-white p-6 sm:p-8">
            <f.icon class="h-6 w-6 text-blue-600" stroke-width={1.5} />
            <h3 class="mt-5 font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-1.5 text-[15px] leading-relaxed text-slate-600">{f.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
