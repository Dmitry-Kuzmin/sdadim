---
/**
 * Карточка Skilyapp в сайдбаре (статьи — под содержанием, блог — под рубриками).
 * Сайдбар узкий (~190 px на lg): короткие строки без переносов, цвета — токены темы, как у оглавления.
 */
import { ArrowRight } from "@lucide/astro";
import { skilyUrl } from "@/lib/skily";

const ITEMS = ["Все вопросы DGT", "Дуэли и игры на знаки", "Словарь и испанский"];
---

<a
  href={skilyUrl("/ru", "sidebar")}
  target="_blank"
  rel="noopener"
  class="group block overflow-hidden rounded-xl border border-slate-200 bg-slate-50 no-underline transition-colors hover:border-blue-500/40"
>
  <img src="/assets/skily/duel-sm.webp" alt="" width="570" height="133" loading="lazy" decoding="async" class="block h-auto w-full" />
  <div class="p-4">
    <p class="mb-1.5 text-[11px] font-bold uppercase tracking-widest text-blue-600">Skilyapp · бесплатно</p>
    <p class="mb-3 text-sm font-bold leading-snug text-slate-900">Тренажёр теории DGT на русском</p>
    <ul class="mb-4 space-y-1 text-xs text-slate-600">
      {ITEMS.map((t) => <li class="flex gap-1.5"><span class="text-emerald-600">✓</span>{t}</li>)}
    </ul>
    <span class="flex items-center justify-center gap-1.5 whitespace-nowrap rounded-lg bg-blue-600 py-2 text-[13px] font-semibold text-white transition-colors group-hover:bg-blue-700">
      Попробовать <ArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>
</a>
