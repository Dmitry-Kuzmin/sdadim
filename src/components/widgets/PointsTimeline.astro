---
/** График баллов с зачётом стажа и без — логика и тексты в @/lib/points */
import { pointsNowHtml, pointsStepsHtml } from "@/lib/points";
---

<div data-points class="not-prose my-10 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-[0_1px_2px_rgba(15,23,42,0.04),0_24px_48px_-24px_rgba(15,23,42,0.18)]">
  <div class="border-b border-slate-200 p-6 md:p-8">
    <p class="text-xs font-bold uppercase tracking-widest text-blue-600">Ваши баллы по годам</p>
    <h3 class="mt-2 text-2xl font-bold text-slate-900">Что даёт зачёт стажа</h3>
    <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-end">
      <label class="block flex-1">
        <span class="text-sm font-semibold text-slate-700">Когда получили испанские права</span>
        <input data-date type="date" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-base text-slate-900 focus:border-blue-500/50 focus:outline-none" />
      </label>
      <div class="flex rounded-xl bg-slate-100 p-1 text-sm font-semibold" role="radiogroup" aria-label="Стаж">
        <button type="button" data-mode="novice" aria-checked="true" role="radio" class="rounded-lg px-4 py-2.5 transition-colors aria-checked:bg-blue-600 aria-checked:text-white aria-checked:shadow-sm aria-[checked=false]:text-slate-500">Без зачёта</button>
        <button type="button" data-mode="staj" aria-checked="false" role="radio" class="rounded-lg px-4 py-2.5 transition-colors aria-checked:bg-blue-600 aria-checked:text-white aria-checked:shadow-sm aria-[checked=false]:text-slate-500">Стаж внесён</button>
      </div>
    </div>
  </div>

  <ol data-steps class="grid gap-px bg-slate-200 sm:grid-cols-4" set:html={pointsStepsHtml("novice", null)} />
  <p data-now class="border-t border-slate-200 bg-slate-50 px-6 py-4 text-sm text-slate-600 md:px-8">Укажите дату — покажем, где вы сейчас.</p>
</div>

<script>
  import { pointsNowHtml, pointsStepsHtml, type POINTS_PLAN } from "@/lib/points";

  document.querySelectorAll<HTMLElement>("[data-points]").forEach((root) => {
    let mode: keyof typeof POINTS_PLAN = "novice";
    const input = root.querySelector<HTMLInputElement>("[data-date]")!;
    const render = () => {
      const start = input.value ? new Date(input.value + "T00:00:00") : null;
      root.querySelector("[data-steps]")!.innerHTML = pointsStepsHtml(mode, start);
      root.querySelector("[data-now]")!.innerHTML = pointsNowHtml(mode, start);
    };
    root.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((b, _, all) =>
      b.addEventListener("click", () => {
        mode = b.dataset.mode as keyof typeof POINTS_PLAN;
        all.forEach((x) => x.setAttribute("aria-checked", String(x === b)));
        render();
      })
    );
    input.addEventListener("input", render);
  });
</script>
