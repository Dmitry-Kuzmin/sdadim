---
/**
 * Когда продлевать испанские права (RD 818/2009, ст. 12–13): окно — за 3 месяца до окончания,
 * новый срок считается от даты окончания. Категория B: 10 лет до 65, 5 лет после.
 * Пошлина 4.3; кому на дату окончания больше 70 — бесплатно.
 */
import { CalendarClock } from "@lucide/astro";
import { T } from "@/lib/facts";
---

<div data-renewal data-tasa={T.renewal} class="not-prose my-10 rounded-3xl border border-slate-200 bg-slate-50 p-6 md:p-8">
  <div class="flex items-center gap-3">
    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white"><CalendarClock class="h-5 w-5" /></span>
    <div>
      <h3 class="text-xl font-bold text-slate-900">Когда продлевать ваши права</h3>
      <p class="text-sm text-slate-500">Испанские права категории B</p>
    </div>
  </div>
  <div class="mt-6 grid gap-4 sm:grid-cols-[1fr_1.3fr]">
    <div class="space-y-4">
      <label class="block">
        <span class="text-sm font-semibold text-slate-700">Срок действия прав</span>
        <input data-exp type="date" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-base text-slate-900 focus:border-blue-500/50 focus:outline-none" />
        <span class="mt-1.5 block text-xs text-slate-500">Поле 4b на лицевой стороне карточки</span>
      </label>
      <label class="block">
        <span class="text-sm font-semibold text-slate-700">Дата рождения</span>
        <input data-birth type="date" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-base text-slate-900 focus:border-blue-500/50 focus:outline-none" />
      </label>
    </div>
    <div data-out class="rounded-2xl bg-white p-5 ring-1 ring-slate-200">
      <p class="text-sm text-slate-500">Укажите обе даты — посчитаем, когда можно продлевать и сколько это стоит.</p>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-renewal]").forEach((root) => {
    const exp = root.querySelector<HTMLInputElement>("[data-exp]")!;
    const birth = root.querySelector<HTMLInputElement>("[data-birth]")!;
    const out = root.querySelector<HTMLElement>("[data-out]")!;
    const fmt = (d: Date) => d.toLocaleDateString("ru-RU", { day: "numeric", month: "long", year: "numeric" }).replace(/\s*г\.$/, "");
    const age = (b: Date, at: Date) => at.getFullYear() - b.getFullYear() - (at < new Date(at.getFullYear(), b.getMonth(), b.getDate()) ? 1 : 0);
    const render = () => {
      if (!exp.value || !birth.value) return;
      const e = new Date(exp.value + "T00:00:00");
      const b = new Date(birth.value + "T00:00:00");
      const open = new Date(e);
      open.setMonth(open.getMonth() - 3);
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const ageAtExp = age(b, e);
      const years = ageAtExp >= 65 ? 5 : 10;
      const free = ageAtExp >= 70;
      const daysToOpen = Math.round((open.getTime() - today.getTime()) / 86400000);
      const expired = e < today;
      const status = expired
        ? `<p class="text-sm font-semibold text-red-600">Срок истёк ${fmt(e)} — за руль нельзя. Продлить можно и сейчас, экзамены не нужны.</p>`
        : daysToOpen > 0
          ? `<p class="text-sm font-semibold text-slate-900">Продлевать можно с ${fmt(open)}</p><p class="text-sm text-slate-500">через ${daysToOpen} дн.</p>`
          : `<p class="text-sm font-semibold text-emerald-600">Можно продлевать уже сейчас — до ${fmt(e)}</p><p class="text-sm text-slate-500">Дни не потеряете: новый срок начнётся от ${fmt(e)}.</p>`;
      out.innerHTML =
        status +
        `<ul class="mt-4 space-y-2 text-sm text-slate-700">` +
        `<li class="flex justify-between gap-4"><span>Новый срок</span><strong class="text-slate-900">${years} лет</strong></li>` +
        `<li class="flex justify-between gap-4"><span>Пошлина DGT</span><strong class="text-slate-900">${free ? "бесплатно (70+)" : root.dataset.tasa}</strong></li>` +
        `<li class="flex justify-between gap-4"><span>Плюс медкомиссия</span><strong class="text-slate-900">цена центра</strong></li></ul>`;
    };
    exp.addEventListener("input", render);
    birth.addEventListener("input", render);
  });
</script>
