---
/**
 * Когда машине на ITV (легковая, Real Decreto 920/2017, ст. 6):
 * первая — через 4 года после первой регистрации, потом раз в 2 года, после 10 лет — каждый год.
 */
import { Wrench } from "@lucide/astro";
import Shell from "./Shell.astro";
---

<Shell icon={Wrench} title="Когда вашей машине на ITV" sub="Легковая машина, правила Real Decreto 920/2017" data-itv>
  <div class="wx-2col">
    <div>
      <label class="block">
        <span class="wx-label">Первая регистрация <span class="wx-tip" tabindex="0" data-side="start" data-tip="Поле «Fecha de primera matriculación» в техпаспорте (permiso de circulación). Не дата покупки — у подержанной машины она другая."></span></span>
        <input data-date type="date" class="wx-field mt-2" />
      </label>
      <div class="mt-4 space-y-1.5 text-xs text-slate-500">
        <p class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-emerald-500"></span>0–4 года — ITV не нужна</p>
        <p class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-blue-500"></span>4–10 лет — раз в 2 года</p>
        <p class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-amber-500"></span>10+ лет — каждый год</p>
      </div>
    </div>
    <div data-out aria-live="polite">
      <div class="wx-empty"><Wrench class="h-5 w-5 text-slate-300" />Укажите дату — покажем ближайшие техосмотры</div>
    </div>
  </div>
</Shell>

<script>
  import { daysBetween, fmtDate, parseDate, plural, today, tween } from "@/lib/widget-fx";

  // Классы собираются из tone — перечислены для Tailwind: bg-emerald-100 bg-blue-100 bg-amber-100 text-emerald-700 text-blue-700 text-amber-700 text-emerald-600 text-blue-600 text-amber-600
  // Возраст машины (лет), когда нужна ITV: 4, 6, 8, 10, затем каждый год
  const AGES = [4, 6, 8, 10, ...Array.from({ length: 30 }, (_, i) => 11 + i)];

  document.querySelectorAll<HTMLElement>("[data-itv]").forEach((root) => {
    const input = root.querySelector<HTMLInputElement>("[data-date]")!;
    const out = root.querySelector<HTMLElement>("[data-out]")!;

    input.addEventListener("input", () => {
      const reg = parseDate(input.value);
      if (!reg) return;
      const at = (y: number) => {
        const d = new Date(reg);
        d.setFullYear(d.getFullYear() + y);
        return d;
      };
      const now = today();
      const age = (now.getTime() - reg.getTime()) / (365.25 * 86400000);
      if (age < 0) {
        out.innerHTML = `<div class="wx-empty wx-in">Дата в будущем — проверьте год</div>`;
        return;
      }
      const next = AGES.map((a) => ({ a, d: at(a) })).filter((x) => x.d >= now).slice(0, 3);
      const days = daysBetween(now, next[0].d);
      const tone = age < 4 ? "emerald" : age < 10 ? "blue" : "amber";
      const rule = age < 4 ? "Первые 4 года ITV не нужна" : age < 10 ? "Сейчас — раз в 2 года" : "Машине больше 10 лет — каждый год";

      // Шкала возраста машины: от 0 до года третьей будущей ITV
      const span = Math.max(next[next.length - 1].a, 12);
      const pos = (a: number) => `${(a / span) * 100}%`;
      const dots = AGES.filter((a) => a <= span)
        .map((a) => `<span class="wx-track-dot" style="left:${pos(a)};${at(a) < now ? "background:rgb(var(--c-slate-400))" : ""}${a === next[0].a ? ";width:12px;height:12px;margin-left:-6px;background:rgb(var(--c-" + tone + "-500))" : ""}" title="${a} лет"></span>`)
        .join("");

      out.innerHTML = `<div class="wx-in rounded-xl bg-slate-50 p-4 ring-1 ring-slate-200">
        <p class="inline-flex items-center gap-1.5 rounded-full bg-${tone}-100 px-2.5 py-0.5 text-xs font-semibold text-${tone}-700">${rule}</p>
        <p class="mt-3 text-xs font-medium text-slate-500">Ближайшая ITV</p>
        <p class="text-2xl font-bold text-slate-900">${fmtDate(next[0].d)}</p>
        <p class="text-sm text-slate-500">через <strong data-days class="wx-num text-${tone}-600">0</strong> ${plural(days, "день", "дня", "дней")}</p>
        <div class="wx-track mt-5" style="--fill:rgb(var(--c-${tone}-500))"><span class="wx-track-fill" data-fill style="width:0"></span>${dots}<span class="wx-track-mark" data-mark style="left:0"></span></div>
        <div class="mt-1.5 flex justify-between text-[11px] text-slate-500"><span>новая</span><span>${span} лет</span></div>
        <ul class="mt-3 space-y-1">${next
          .slice(1)
          .map((x) => `<li class="flex items-center justify-between text-[13px]"><span class="text-slate-500">Затем · ${x.a} ${plural(x.a, "год", "года", "лет")} машине</span><span class="font-semibold text-slate-800">${fmtDate(x.d)}</span></li>`)
          .join("")}</ul>
        <p class="mt-3 text-[11px] leading-relaxed text-slate-500">Действующая дата — на наклейке ITV на лобовом стекле. Запись на станцию лучше брать за пару недель.</p>
      </div>`;
      const fill = out.querySelector<HTMLElement>("[data-fill]")!, mark = out.querySelector<HTMLElement>("[data-mark]")!;
      const d = out.querySelector<HTMLElement>("[data-days]")!;
      d.dataset.v = "0";
      tween(d, days);
      requestAnimationFrame(() => requestAnimationFrame(() => {
        fill.style.width = pos(Math.min(age, span));
        mark.style.left = pos(Math.min(age, span));
      }));
    });
  });
</script>
