---
/**
 * «Можно ли обменять мои права?» — поиск страны и ответ: ЕС / соглашение / только экзамен.
 * Данные — src/data/canje.ts (список DGT). Все три ответа — в HTML, скрипт показывает нужный.
 * Ответ появляется, когда страна определилась однозначно: точное совпадение или единственная по началу названия.
 * Страны нет в списке DGT (и ввод не похож на начало известной) — соглашения нет.
 */
import { ArrowRight, CheckCircle2, GraduationCap, Search, ShieldCheck } from "@lucide/astro";
import { CONVENIO, EU_EEA, NO_CONVENIO_POPULAR } from "@/data/canje";
import { TASAS, TASA_DGT, eur } from "@/lib/license-costs";
import Shell from "./Shell.astro";

const QUICK = ["Россия", "Украина", "Беларусь", "Казахстан", "Грузия", "Молдова", "Великобритания"];
const all = [...CONVENIO.map((c) => c.name), ...EU_EEA, ...NO_CONVENIO_POPULAR].sort((a, b) => a.localeCompare(b, "ru"));
const data = {
  convenio: Object.fromEntries(CONVENIO.map((c) => [c.name.toLowerCase(), c])),
  eu: EU_EEA.map((c) => c.toLowerCase()),
  all,
};
---

<Shell icon={Search} title="Можно ли обменять ваши права?" sub="Важна страна, которая выдала права, а не ваше гражданство" data-country-check data-db={JSON.stringify(data)} data-tasa-canje={eur(TASAS.canje)} data-tasa-exam={eur(TASA_DGT)}>
  <div class="relative">
    <Search class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
    <input data-input list="canje-countries" type="search" autocomplete="off" placeholder="Начните вводить страну…" aria-label="Страна, выдавшая права" class="wx-field !pl-10" />
    <datalist id="canje-countries">{all.map((c) => <option value={c} />)}</datalist>
  </div>
  <div class="mt-2.5 flex flex-wrap gap-1.5">
    {QUICK.map((c) => <button type="button" data-quick={c} aria-pressed="false" class="wx-chip">{c}</button>)}
  </div>

  <div aria-live="polite">
    <div data-result="eu" hidden class="mt-5 rounded-xl border border-emerald-500/30 bg-emerald-50 p-4">
      <p class="flex items-center gap-2 font-bold text-emerald-700"><ShieldCheck class="h-5 w-5 flex-none" /> <span><span data-country></span>: обмен не нужен</span></p>
      <p class="mt-1.5 text-[14px] leading-relaxed text-slate-700">Права стран ЕС и ЕЭЗ действуют в Испании без ограничений по сроку, пока не истекли. Когда срок подойдёт к концу, продлите их уже в Испании — экзаменов не будет.</p>
    </div>

    <div data-result="convenio" hidden class="mt-5 rounded-xl border border-blue-500/30 bg-blue-50 p-4">
      <p class="flex items-center gap-2 font-bold text-blue-700"><CheckCircle2 class="h-5 w-5 flex-none" /> <span><span data-country></span>: меняется без экзаменов</span></p>
      <ul class="mt-2 space-y-1.5 text-[14px] leading-relaxed text-slate-700">
        <li>Машина и мотоцикл (A, B) — <strong class="text-slate-900">без экзаменов</strong>, пошлина DGT {eur(TASAS.canje)}.</li>
        <li data-heavy>Грузовик и автобус (C, D) — <span data-heavy-text></span>.</li>
        <li data-cond>Главное условие — права получены <strong class="text-slate-900">до того, как вы стали резидентом Испании</strong>.</li>
      </ul>
      <p data-note hidden class="mt-2.5 rounded-lg bg-white p-3 text-[13px] text-slate-600"></p>
      <a href="/blog/obmen-prav-v-ispanii#kak-obmenyat" class="group mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 hover:text-blue-700">Как обменять — по шагам <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" /></a>
    </div>

    <div data-result="none" hidden class="mt-5 rounded-xl border border-amber-500/30 bg-amber-50 p-4">
      <p class="flex items-center gap-2 font-bold text-amber-700"><GraduationCap class="h-5 w-5 flex-none" /> <span><span data-country></span>: соглашения нет — только экзамены</span></p>
      <ul class="mt-2 space-y-1.5 text-[14px] leading-relaxed text-slate-700">
        <li>Ездить по своим правам можно <strong class="text-slate-900">6 месяцев</strong> с начала резиденции.</li>
        <li>Дальше — теория и вождение в DGT, как у всех. Опытному водителю на вождение обычно хватает нескольких уроков.</li>
        <li>После экзамена стаж можно внести в базу DGT — и не быть «новичком» с 8 баллами и знаком L.</li>
      </ul>
      <a href="/blog/stazh-rossiyskih-prav-v-ispanii" class="group mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-amber-700 hover:text-amber-800">Как зачесть стаж <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" /></a>
    </div>
  </div>
</Shell>

<script>
  import { replay } from "@/lib/widget-fx";

  type Conv = { name: string; heavy: string | null; note?: string; afterResidence?: boolean };

  document.querySelectorAll<HTMLElement>("[data-country-check]").forEach((root) => {
    const db = JSON.parse(root.dataset.db!) as { convenio: Record<string, Conv>; eu: string[]; all: string[] };
    const input = root.querySelector<HTMLInputElement>("[data-input]")!;
    const results = root.querySelectorAll<HTMLElement>("[data-result]");
    const chips = root.querySelectorAll<HTMLButtonElement>("[data-quick]");
    const norm = (s: string) => s.trim().toLowerCase().replace(/ё/g, "е");
    let shown = "";

    // Страна из списка: точное совпадение, иначе единственная по началу названия
    const resolve = (q: string) => {
      const exact = db.all.find((c) => norm(c) === q);
      if (exact) return exact;
      const pre = db.all.filter((c) => norm(c).startsWith(q));
      return pre.length === 1 ? pre[0] : pre.length ? undefined : null;
    };

    const show = (raw: string) => {
      const q = norm(raw);
      chips.forEach((c) => c.setAttribute("aria-pressed", String(norm(c.dataset.quick!) === q)));
      const name = q.length < 3 ? undefined : resolve(q);
      // undefined — ввод ещё неоднозначен; null — такой страны в списках нет
      if (name === undefined || (name === null && q.length < 4)) {
        results.forEach((r) => (r.hidden = true));
        shown = "";
        return;
      }
      const conv = name ? db.convenio[name.toLowerCase()] : undefined;
      const kind = conv ? "convenio" : name && db.eu.includes(name.toLowerCase()) ? "eu" : "none";
      const label = name ?? raw.trim();
      const box = root.querySelector<HTMLElement>(`[data-result="${kind}"]`)!;
      results.forEach((r) => (r.hidden = r !== box));
      box.querySelector("[data-country]")!.textContent = label;
      if (conv) {
        box.querySelector("[data-heavy-text]")!.textContent = conv.heavy ? `экзамены: ${conv.heavy}, пошлина ${root.dataset.tasaExam}` : `без экзаменов, пошлина ${root.dataset.tasaCanje}`;
        box.querySelector<HTMLElement>("[data-cond]")!.hidden = !!conv.afterResidence;
        const note = box.querySelector<HTMLElement>("[data-note]")!;
        note.textContent = conv.note ?? "";
        note.hidden = !conv.note;
      }
      if (shown !== label) replay(box, "wx-in");
      shown = label;
    };

    input.addEventListener("input", () => show(input.value));
    chips.forEach((b) =>
      b.addEventListener("click", () => {
        input.value = b.dataset.quick!;
        show(input.value);
      })
    );
  });
</script>
