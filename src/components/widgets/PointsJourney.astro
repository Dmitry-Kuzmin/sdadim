---
/**
 * Инфографика «Путь баллов новичка»: лестница 8 → 12 → 14 → 15 и что сбивает с пути.
 * Закон о движении (RDL 6/2015): ст. 63 — 8 баллов новичку, 12 через 2 года без потери баллов,
 * +2 за следующие 3 года, +1 ещё за 3 (максимум 15); ст. 63.7 — курс возвращает до 6 баллов раз в 2 года;
 * ст. 63.4 — при нуле права недействительны, новые — через 6 месяцев после курса и экзамена.
 * Каждый балл — кубик; новые подсвечены цветом ступени. Ступени появляются при прокрутке.
 */
import { Ban, CircleAlert, Play, RotateCcw, TrendingUp } from "@lucide/astro";
import Shell from "./Shell.astro";

const STEPS = [
  { pts: 8, add: 8, when: "Экзамен", year: 0, cond: "Права в руках", tone: "blue", detail: "Старт новичка — 8 баллов. Первый год — знак L на машине, первые 2 года — лимит алкоголя 0,15 мг/л (у остальных 0,25)." },
  { pts: 12, add: 4, when: "2 года", year: 2, cond: "Без потери баллов", tone: "emerald", detail: "Два года без нарушений с потерей баллов — и счёт становится 12, как у обычного водителя. Знак L и лимит 0,15 позади." },
  { pts: 14, add: 2, when: "5 лет", year: 5, cond: "+3 года чисто", tone: "violet", detail: "Ещё 3 года без нарушений с потерей баллов — бонус +2. Нарушили — отсчёт этих трёх лет начинается заново." },
  { pts: 15, add: 1, when: "8 лет", year: 8, cond: "+3 года чисто", tone: "amber", detail: "Ещё 3 года — последний +1. 15 — максимум: больше не дают, сколько бы лет вы ни ездили аккуратно." },
];
const BRANCHES = [
  { icon: CircleAlert, tone: "red", title: "Нарушили", text: "Баллы списывают, а отсчёт лет «без нарушений» начинается заново — до следующей ступени дальше." },
  { icon: RotateCcw, tone: "emerald", title: "Вернуть", text: "Два года без нарушений — снова 12. Быстрее — курс в автошколе: до +6 баллов, раз в 2 года." },
  { icon: Ban, tone: "slate", title: "Ноль", text: "Права недействительны. Через 6 месяцев — курс и экзамен по теории, и снова 8 баллов, как новичок." },
];
// Классы из tone — для Tailwind: text-blue-600 text-emerald-600 text-violet-600 text-amber-600 bg-red-50 bg-emerald-50 bg-slate-100 text-red-600 text-slate-600
---

<Shell icon={TrendingUp} tone="violet" title="Путь баллов новичка" sub="Как растут баллы от экзамена до максимума — и что сбивает с пути" data-journey data-details={JSON.stringify(STEPS.map((s) => s.detail))}>
  <button slot="aside" type="button" data-replay class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900"><Play class="h-3.5 w-3.5" /> Ещё раз</button>

  <!-- Лестница -->
  <div class="pj-stairs" role="tablist" aria-label="Ступени баллов">
    {
      STEPS.map((s, i) => (
        <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-step={i} class="pj-col" style={`--tone:var(--c-${s.tone}-500);--i:${i}`}>
          <span class:list={["pj-num", `text-${s.tone}-600`]}>
            {s.pts}
            {i > 0 && <small>+{s.add}</small>}
          </span>
          <span class="pj-stack" aria-hidden="true">
            {Array.from({ length: s.pts }, (_, k) => (
              <i class:list={[k >= s.pts - s.add && "new"]} style={`--k:${k}`} />
            ))}
          </span>
          <span class="pj-when">{s.when}</span>
          <span class="pj-cond">{s.cond}</span>
        </button>
      ))
    }
  </div>

  <p data-detail aria-live="polite" class="wx-in mt-3 min-h-[3.5rem] rounded-xl bg-slate-50 px-4 py-3 text-[13px] leading-relaxed text-slate-700 ring-1 ring-slate-200">{STEPS[0].detail}</p>

  <!-- Что сбивает с пути -->
  <div class="mt-4 grid gap-2 sm:grid-cols-3">
    {
      BRANCHES.map((b) => (
        <div class:list={["rounded-xl p-3.5", b.tone === "slate" ? "bg-slate-100" : `bg-${b.tone}-50`]}>
          <p class:list={["flex items-center gap-1.5 text-sm font-bold", `text-${b.tone}-600`]}>
            <b.icon class="h-4 w-4" /> {b.title}
          </p>
          <p class="mt-1 text-[12.5px] leading-snug text-slate-600">{b.text}</p>
        </div>
      ))
    }
  </div>
  <p class="mt-3 text-[11px] text-slate-500">Закон о движении (RDL 6/2015), ст. 63. Зачли стаж прошлых прав — путь начинается сразу с 12.</p>
</Shell>

<style>
  .pj-stairs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: end; gap: 0.5rem; }
  .pj-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    border-radius: 14px;
    padding: 0.5rem 0.25rem 0.6rem;
    transition: background 0.2s, transform 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
  .pj-col:hover { background: rgb(var(--c-slate-50)); }
  .pj-col[aria-selected="true"] { background: rgb(var(--tone) / 0.08); box-shadow: inset 0 0 0 1.5px rgb(var(--tone) / 0.35); }
  .pj-col:focus-visible { outline: 2px solid rgb(var(--tone)); outline-offset: 2px; }
  .pj-num { font-size: 1.75rem; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
  .pj-num small { margin-left: 2px; font-size: 0.75rem; font-weight: 700; opacity: 0.8; vertical-align: super; }
  .pj-stack { display: flex; width: min(100%, 3.5rem); flex-direction: column-reverse; gap: 3px; }
  .pj-stack i { display: block; height: 9px; border-radius: 3px; background: rgb(var(--c-slate-300)); }
  .pj-stack i.new { background: rgb(var(--tone)); }
  .pj-when { font-size: 0.8125rem; font-weight: 700; color: rgb(var(--c-slate-900)); }
  .pj-cond { font-size: 0.6875rem; line-height: 1.25; color: rgb(var(--c-slate-500)); text-align: center; }

  /* Появление: ступени по очереди, кубики снизу вверх */
  :global([data-journey]:not([data-play])) .pj-stack i { opacity: 0; transform: scaleY(0.2) translateY(6px); }
  :global([data-journey][data-play]) .pj-stack i { animation: pj-pop 0.35s cubic-bezier(0.3, 1.6, 0.5, 1) both; animation-delay: calc(var(--i) * 380ms + var(--k) * 28ms); }
  :global([data-journey]:not([data-play])) .pj-num { opacity: 0; }
  :global([data-journey][data-play]) .pj-num { animation: pj-fade 0.4s both; animation-delay: calc(var(--i) * 380ms + 250ms); }
  @keyframes pj-pop { from { opacity: 0; transform: scaleY(0.2) translateY(6px); } }
  @keyframes pj-fade { from { opacity: 0; transform: translateY(4px); } }
  @media (prefers-reduced-motion: reduce) {
    :global([data-journey]) .pj-stack i, :global([data-journey]) .pj-num { animation: none !important; opacity: 1 !important; transform: none !important; }
  }
  @container (max-width: 420px) {
    .pj-num { font-size: 1.375rem; }
    .pj-stack i { height: 7px; }
  }
</style>

<script>
  import { onVisible, replay } from "@/lib/widget-fx";

  document.querySelectorAll<HTMLElement>("[data-journey]").forEach((root) => {
    const details = JSON.parse(root.dataset.details!) as string[];
    const out = root.querySelector<HTMLElement>("[data-detail]")!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-step]")];
    const play = () => {
      delete root.dataset.play;
      void root.offsetWidth;
      root.dataset.play = "";
    };
    onVisible(root, play);
    root.querySelector("[data-replay]")!.addEventListener("click", play);
    tabs.forEach((t) =>
      t.addEventListener("click", () => {
        tabs.forEach((x) => x.setAttribute("aria-selected", String(x === t)));
        out.textContent = details[Number(t.dataset.step)];
        replay(out, "wx-in");
      })
    );
  });
</script>
