---
/** Сайдбар статьи из блоков frontmatter (sidebar: [...]) — см. src/content.config.ts */
import type { Post } from "@/lib/blog";
import { ARTICLE_ICONS } from "@/lib/article-icons";
import Banner from "@/components/article/Banner.astro";
import { cn } from "@/lib/utils";

interface Props {
  blocks: Post["data"]["sidebar"];
}

const { blocks } = Astro.props;

const TONE = {
  blue: { box: "border-blue-500/20 bg-blue-500/5", icon: "text-blue-600", link: "text-blue-600 hover:text-blue-700" },
  emerald: { box: "border-emerald-500/20 bg-emerald-500/5", icon: "text-emerald-600", link: "text-emerald-600 hover:text-emerald-700" },
  red: { box: "border-red-500/20 bg-red-500/5", icon: "text-red-600", link: "text-red-600 hover:text-red-700" },
};
---

<div class="sticky top-24 space-y-5">
  {
    blocks.map((b) => {
      if (b.type === "toc")
        return (
          <div class={cn("rounded-xl bg-slate-50 p-5", b.bordered && "border border-slate-200")}>
            <p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-4">Содержание</p>
            <nav data-toc class="space-y-2 text-sm">
              {b.items.map(([href, label]) => (
                <a href={href} class="block text-slate-600 hover:text-slate-900 transition-colors leading-snug aria-[current=true]:text-slate-900 aria-[current=true]:font-medium">
                  {label}
                </a>
              ))}
            </nav>
          </div>
        );
      if (b.type === "fact") {
        const Icon = ARTICLE_ICONS[b.icon];
        return (
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <div class="flex justify-between items-center mb-3">
              <p class="text-xs font-bold uppercase tracking-widest text-slate-500">{b.title}</p>
              <Icon class={b.iconClass} />
            </div>
            <p class="text-sm text-slate-700 mb-0" set:html={b.html} />
          </div>
        );
      }
      if (b.type === "card") {
        const t = TONE[b.tone];
        const Icon = b.icon && ARTICLE_ICONS[b.icon];
        return (
          <div class={cn("rounded-xl border p-5", t.box)}>
            {Icon && b.inlineIcon ? (
              <p class="text-slate-900 font-bold text-sm mb-2">
                <Icon class={cn("w-4 h-4 inline -mt-0.5 mr-1", t.icon)} />
                {b.title}
              </p>
            ) : Icon ? (
              <div class="flex items-center gap-2 mb-3">
                <Icon class={cn("w-4 h-4", t.icon)} />
                <p class="text-slate-900 font-bold text-sm">{b.title}</p>
              </div>
            ) : (
              <p class="text-slate-900 font-bold text-sm mb-2" set:html={b.title} />
            )}
            <p class={cn("text-slate-600 text-xs leading-relaxed", b.link && "mb-4", b.textClass)} set:html={b.html} />
            {b.link && (
              <a href={b.link.href} target="_blank" rel="noopener noreferrer" class={cn("inline-flex items-center gap-1 text-xs font-semibold transition-colors", t.link)}>
                {b.link.text}
              </a>
            )}
          </div>
        );
      }
      if (b.type === "stat")
        return (
          <div class="rounded-xl bg-slate-50 p-5 text-center">
            <p class="text-3xl font-bold text-slate-900 mb-1">{b.value}</p>
            <p class="text-xs text-slate-500 uppercase tracking-wider font-bold">{b.label}</p>
            {b.note && (
              <div class="mt-3 pt-3 border-t border-slate-200">
                <p class="text-[11px] text-slate-400">{b.note}</p>
              </div>
            )}
          </div>
        );
      return <Banner variant={b.variant} />;
    })
  }
</div>

<script>
  // Оглавление подсвечивает раздел, который сейчас читают
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc] a")];
  const targets = links.map((a) => document.querySelector(a.hash)).filter(Boolean) as Element[];
  if (targets.length) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
        const first = targets.find((t) => visible.has(t));
        if (first) links.forEach((a) => a.setAttribute("aria-current", String(a.hash === `#${first.id}`)));
      },
      { rootMargin: "-80px 0px -60% 0px" }
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
