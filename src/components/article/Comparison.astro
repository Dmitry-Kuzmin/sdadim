---
import { CheckCircle2, XCircle } from "@lucide/astro";

interface Props {
  headerA: string;
  headerB: string;
  rows: { feature: string; a: boolean | string; b: boolean | string }[];
}

const { headerA, headerB, rows } = Astro.props;
---

<div class="my-8 not-prose overflow-x-auto rounded-2xl border border-slate-200">
  <table class="w-full min-w-[400px] text-sm">
    <thead>
      <tr class="border-b border-slate-200">
        <th class="px-5 py-4 text-left text-xs font-bold uppercase tracking-widest text-slate-400 w-1/2">Параметр</th>
        <th class="px-5 py-4 text-center text-xs font-bold uppercase tracking-widest text-slate-500">{headerA}</th>
        <th class="px-5 py-4 text-center text-xs font-bold uppercase tracking-widest text-blue-600 bg-blue-500/5">{headerB}</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-200">
      {
        rows.map((row) => (
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-5 py-3.5 text-slate-600 font-medium">{row.feature}</td>
            {[row.a, row.b].map((v, i) => (
              <td class={i === 1 ? "px-5 py-3.5 text-center bg-blue-500/[0.03]" : "px-5 py-3.5 text-center"}>
                {typeof v === "boolean" ? (
                  v ? <CheckCircle2 class="w-5 h-5 text-emerald-600 mx-auto" /> : <XCircle class="w-5 h-5 text-red-600/50 mx-auto" />
                ) : (
                  <span class="text-slate-700 text-sm">{v}</span>
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
