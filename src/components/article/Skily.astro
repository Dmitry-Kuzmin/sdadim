---
/**
 * Контекстная врезка про Skilyapp в тексте статьи: <Skily feature="dictionary" />.
 * Тексты — в src/lib/skily.ts; title/text можно переопределить под абзац.
 */
import { ArrowRight } from "@lucide/astro";
import { SKILY_FEATURES, skilyUrl, type SkilyFeature } from "@/lib/skily";

interface Props {
  feature?: SkilyFeature;
  title?: string;
  text?: string;
}

const { feature = "tests", title, text } = Astro.props;
const f = SKILY_FEATURES[feature];
---

<a
  href={skilyUrl(f.path, `article-${feature}`)}
  target="_blank"
  rel="noopener"
  class="my-8 not-prose group flex items-start gap-4 rounded-2xl border border-blue-500/20 bg-gradient-to-r from-blue-500/[0.07] to-orange-500/[0.05] p-5 no-underline transition-colors hover:border-blue-500/40"
>
  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[#070b16] text-xl ring-1 ring-blue-500/30" aria-hidden="true">{f.emoji}</span>
  <span class="flex-1 min-w-0">
    <span class="block text-[11px] font-bold uppercase tracking-widest text-blue-600 mb-1">Skilyapp</span>
    <span class="block font-bold text-slate-900 leading-snug mb-1">{title ?? f.title}</span>
    <span class="block text-sm text-slate-600 leading-relaxed">{text ?? f.text}</span>
    <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-blue-600 group-hover:text-blue-700">
      {f.cta} <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
    </span>
  </span>
</a>
