---
/**
 * Баннер курса в статьях. HTML — сразу, дата старта и свободные места подставляются
 * скриптом из Supabase (та же база, что у бота). Нет данных — баннер остаётся без них.
 */
import { ArrowRight, Calendar, Clock, Users, Zap } from "@lucide/astro";

interface Props {
  basePrice?: number;
  variant?: "default" | "compact" | "inline";
}

const { basePrice = 199, variant = "default" } = Astro.props;
const COURSE = "https://t.me/skilyapp_bot?start=course";
---

{
  variant === "compact" && (
    <div data-stream-banner="compact" class="my-6 not-prose rounded-2xl border border-blue-500/20 bg-gradient-to-r from-blue-600/10 to-cyan-600/5 p-4 flex flex-col sm:flex-row sm:items-center gap-4">
      <div class="flex-1">
        <p class="font-bold text-slate-900 text-sm">Записаться на курс теории DGT</p>
        <div class="flex items-center gap-3 mt-1.5 flex-wrap">
          <span data-start hidden class="text-[11px] text-slate-600 flex items-center gap-1">
            <Calendar class="w-3 h-3" /> Старт <span data-start-date />
          </span>
          <span data-seats hidden class="text-[11px] text-amber-600 flex items-center gap-1">
            <Users class="w-3 h-3" /> Осталось <span data-seats-n /> мест
          </span>
        </div>
      </div>
      <a href={COURSE} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm transition-colors shrink-0 no-underline">
        Занять место <ArrowRight class="w-4 h-4" />
      </a>
    </div>
  )
}

{
  variant === "inline" && (
    <div data-stream-banner="inline" class="my-4 not-prose inline-flex items-center gap-3 px-4 py-2.5 rounded-xl border border-blue-500/20 bg-blue-500/8 text-sm">
      <Zap class="w-4 h-4 text-blue-600 shrink-0" />
      <span class="text-slate-700">
        Курс теории DGT
        <span data-start hidden> · Старт <strong class="text-slate-900" data-start-date /></span>
        <span data-seats hidden class="text-amber-600"> · осталось <span data-seats-n /> мест</span>
      </span>
      <a href={COURSE} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-700 font-semibold no-underline whitespace-nowrap">
        Записаться →
      </a>
    </div>
  )
}

{
  variant === "default" && (
    <div data-stream-banner="default" class="my-10 not-prose relative rounded-3xl border border-blue-500/20 bg-gradient-to-br from-slate-50 to-white overflow-hidden shadow-[0_0_60px_-15px_rgba(59,130,246,0.3)]">
      <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl pointer-events-none" />
      <div class="relative z-10 p-7 md:p-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/15 border border-blue-500/25 text-blue-700 text-xs font-bold mb-5">
          🎓 Онлайн-курс теории DGT
        </div>
        <div class="flex flex-col md:flex-row md:items-end gap-6 md:gap-10">
          <div class="flex-1">
            <h3 class="text-2xl md:text-3xl font-bold text-slate-900 leading-tight mb-2">Сдайте теорию с первого раза</h3>
            <p class="text-slate-600 text-sm leading-relaxed mb-5 max-w-md">
              Живые уроки с куратором, разбор всех вопросов DGT, документы под ключ и поддержка в чате 24/7.
            </p>
            <div class="flex flex-wrap items-center gap-4">
              <div data-seats-pill class="flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold border text-slate-600 border-slate-200">
                <Users class="w-3.5 h-3.5" />
                <span data-seats-text>Узнать о местах</span>
              </div>
              <div data-start hidden class="flex items-center gap-2 text-xs text-slate-600">
                <Calendar class="w-3.5 h-3.5 text-slate-400" />
                Старт <strong class="text-slate-900 ml-0.5" data-start-date />
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-600">
                <Clock class="w-3.5 h-3.5 text-slate-400" />
                от <strong class="text-slate-900 ml-0.5">€{basePrice}</strong>
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-2.5 shrink-0">
            <a href={COURSE} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm transition-all hover:shadow-[0_0_25px_rgba(59,130,246,0.4)] no-underline">
              Занять место →
            </a>
            <a href="https://t.me/skilyapp_bot" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-7 py-3 rounded-2xl border border-slate-200 hover:bg-slate-50 text-slate-600 hover:text-slate-900 font-semibold text-sm transition-colors no-underline">
              Бесплатная практика
            </a>
          </div>
        </div>
        <div class="mt-6 pt-5 border-t border-slate-200 flex items-center gap-2">
          <Zap class="w-3.5 h-3.5 text-emerald-600" />
          <span class="text-xs text-slate-500">9 из 10 наших студентов сдают теорию DGT с первого раза</span>
        </div>
      </div>
    </div>
  )
}

<script>
  import { loadStreams, nextOpenStream, spotsLeft } from "@/lib/course-data";

  const banners = document.querySelectorAll<HTMLElement>("[data-stream-banner]");
  if (banners.length)
    loadStreams().then((list) => {
      const s = nextOpenStream(list);
      if (!s) return;
      const seats = spotsLeft(s);
      const date = new Date(s.start_date + "T00:00:00").toLocaleDateString("ru-RU", { day: "numeric", month: "long" });
      banners.forEach((b) => {
        const v = b.dataset.streamBanner;
        b.querySelectorAll("[data-start-date]").forEach((el) => (el.textContent = date));
        b.querySelector<HTMLElement>("[data-start]")!.hidden = false;
        const seatsEl = b.querySelector<HTMLElement>("[data-seats]");
        if (seatsEl && seats <= (v === "inline" ? 8 : 5)) {
          seatsEl.querySelector("[data-seats-n]")!.textContent = String(seats);
          seatsEl.hidden = false;
        }
        const pill = b.querySelector<HTMLElement>("[data-seats-pill]");
        if (pill) {
          const tone =
            seats <= 3 ? "text-red-700 bg-red-500/10 border-red-500/20" : seats <= 6 ? "text-amber-700 bg-amber-500/10 border-amber-500/20" : "text-emerald-700 bg-emerald-500/10 border-emerald-500/20";
          pill.className = `flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold border ${tone}`;
          pill.querySelector("[data-seats-text]")!.textContent = seats <= 3 ? `Последние ${seats} места!` : `Свободно ${seats} мест`;
        }
      });
    });
</script>
