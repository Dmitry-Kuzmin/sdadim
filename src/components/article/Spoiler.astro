---
import { ChevronRight } from "@lucide/astro";

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<details class="group/sp smooth-details my-6 not-prose rounded-xl border border-slate-200 overflow-hidden">
  <summary class="w-full flex items-center gap-3 px-5 py-3.5 text-sm font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition-colors text-left cursor-pointer list-none [&::-webkit-details-marker]:hidden">
    <ChevronRight class="w-4 h-4 text-slate-500 shrink-0 transition-transform duration-200 group-open/sp:rotate-90" />
    {label}
  </summary>
  <div class="px-5 pb-5 border-t border-slate-200 pt-4 text-sm text-slate-600 leading-relaxed">
    <slot />
  </div>
</details>
