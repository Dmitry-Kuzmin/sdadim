---
import { cn } from "@/lib/utils";

interface Props {
  cards: { icon?: string; title: string; description: string; badge?: string }[];
  cols?: 2 | 3;
}

const { cards, cols = 2 } = Astro.props;
---

<div class={cn("my-8 not-prose grid gap-4", cols === 3 ? "grid-cols-1 sm:grid-cols-3" : "grid-cols-1 sm:grid-cols-2")}>
  {
    cards.map((card) => (
      <div class="rounded-2xl bg-slate-50 p-5 hover:bg-slate-100 transition-all">
        {card.icon && <div class="text-2xl mb-3">{card.icon}</div>}
        <div class="flex items-start justify-between gap-2 mb-2">
          <p class="font-bold text-slate-900 text-sm leading-snug">{card.title}</p>
          {card.badge && (
            <span class="text-[10px] font-bold uppercase tracking-wider text-blue-600 bg-blue-500/10 px-2 py-0.5 rounded-full shrink-0">{card.badge}</span>
          )}
        </div>
        <p class="text-sm text-slate-600 leading-relaxed" set:html={card.description} />
      </div>
    ))
  }
</div>
