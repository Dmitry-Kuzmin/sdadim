---
/**
 * Крупные цифры статьи.
 *   <Stats stats={[{ value, label, note }]} />                         — короткие подписи под цифрой
 *   <Stats variant="explain" stats={[{ value, label, text, trap }]} /> — цифра + фраза, что она значит,
 *   и строка «В тесте: …»: когда цифру без пояснения не понять (статьи по темам DGT)
 */
import { CircleAlert } from "@lucide/astro";

interface Stat {
  value: string;
  label: string;
  note?: string;
  /** explain: что значит цифра — одна-две фразы, допускается inline-HTML */
  text?: string;
  /** explain: ловушка или подсказка к тесту */
  trap?: string;
}
interface Props {
  stats: Stat[];
  variant?: "default" | "explain";
}

const { stats, variant = "default" } = Astro.props;
---

{
  variant === "explain" ? (
    <div class="my-8 not-prose grid grid-cols-1 gap-4 sm:grid-cols-2">
      {stats.map((stat) => (
        <div class="flex flex-col rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <div class="text-[11px] font-bold uppercase tracking-widest text-blue-600">{stat.label}</div>
          <div class="mt-2 whitespace-nowrap text-4xl font-bold tracking-tight text-slate-900">{stat.value}</div>
          {stat.text && <p class="mt-3 mb-4 text-sm leading-relaxed text-slate-600" set:html={stat.text} />}
          {stat.trap && (
            <p class="mt-auto flex gap-2 border-t border-slate-200 pt-3 text-[13px] leading-snug text-slate-500">
              <CircleAlert class="mt-0.5 h-4 w-4 shrink-0 text-amber-500" />
              <span>
                <span class="font-semibold text-slate-700">В тесте:</span> <span set:html={stat.trap} />
              </span>
            </p>
          )}
        </div>
      ))}
    </div>
  ) : (
    <div class="my-8 not-prose grid grid-cols-2 sm:grid-cols-4 gap-4">
      {stats.map((stat) => (
        <div class="rounded-2xl bg-slate-50 p-5 text-center">
          <div class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-1">{stat.value}</div>
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide">{stat.label}</div>
          {stat.note && <div class="text-[11px] text-slate-400 mt-1">{stat.note}</div>}
        </div>
      ))}
    </div>
  )
}
