---
/**
 * Вкладки: все панели — в HTML (их видят поисковики), скрипт только переключает.
 * Использование в MDX:
 *   <Tabs labels={["Первая", "Вторая"]}>
 *     <TabPanel>…</TabPanel>
 *     <TabPanel>…</TabPanel>
 *   </Tabs>
 */
import { cn } from "@/lib/utils";

interface Props {
  labels: string[];
}

const { labels } = Astro.props;
---

<div data-tabs class="my-8 not-prose rounded-2xl border border-slate-200 overflow-hidden">
  <div class="flex border-b border-slate-200 bg-slate-50 overflow-x-auto" role="tablist">
    {
      labels.map((label, i) => (
        <button
          type="button"
          role="tab"
          data-tab={i}
          aria-selected={i === 0 ? "true" : "false"}
          class={cn(
            "px-5 py-3 text-sm font-semibold whitespace-nowrap transition-colors border-b-2 -mb-[1px]",
            "aria-selected:text-slate-900 aria-selected:border-blue-500",
            "aria-[selected=false]:text-slate-500 aria-[selected=false]:border-transparent aria-[selected=false]:hover:text-slate-700"
          )}
        >
          {label}
        </button>
      ))
    }
  </div>
  <div class="p-5 [&:not(.ready)>[data-tab-panel]:not(:first-child)]:hidden" data-tab-panels>
    <slot />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-tab]");
    const wrap = root.querySelector<HTMLElement>("[data-tab-panels]")!;
    const panels = wrap.querySelectorAll<HTMLElement>(":scope > [data-tab-panel]");
    const show = (n: number) => {
      buttons.forEach((b, i) => b.setAttribute("aria-selected", String(i === n)));
      panels.forEach((p, i) => (p.hidden = i !== n));
    };
    show(0);
    wrap.classList.add("ready");
    buttons.forEach((b, i) => b.addEventListener("click", () => show(i)));
  });
</script>
