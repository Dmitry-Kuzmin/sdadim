---
/** Картинка с подписью. priority — обложка на первом экране (LCP): грузится сразу */
import { coverSrcSet } from "@/lib/covers";
import { cn } from "@/lib/utils";

interface Props {
  src: string;
  alt: string;
  caption?: string;
  fullWidth?: boolean;
  priority?: boolean;
}

const { src, alt, caption, fullWidth = false, priority = false } = Astro.props;
---

<figure class={cn("my-8 not-prose", !fullWidth && "max-w-2xl mx-auto")}>
  <div class="rounded-2xl overflow-hidden border border-slate-200">
    <img
      src={src}
      srcset={coverSrcSet(src)}
      sizes="(min-width: 768px) 720px, 100vw"
      alt={alt}
      width="1600"
      height="1000"
      class="h-auto w-full object-cover"
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding={priority ? "sync" : "async"}
    />
  </div>
  {caption && <figcaption class="text-center text-xs text-slate-400 mt-3 leading-relaxed">{caption}</figcaption>}
</figure>
