---
/** Слово в списке темы: картинка, испанское слово (ссылка на его страницу, если она есть), озвучка, перевод, толкование. */
import { hasPage, wordImg, wordUrl, type Word } from "@/lib/words";

interface Props {
  w: Word;
  eager?: boolean;
}
const { w, eager } = Astro.props;
---

<li class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-3 sm:p-4">
  {
    w.img ? (
      <img
        src={wordImg(w.id)}
        alt={`${w.es} — ${w.ru}`}
        width="640"
        height="480"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        class={`h-20 w-24 flex-none rounded-xl sm:h-24 sm:w-32 ${w.img === "sign" ? "object-contain" : "object-cover bg-slate-100"}`}
      />
    ) : (
      <span class="grid h-20 w-24 flex-none place-items-center rounded-xl bg-slate-100 text-2xl font-bold text-slate-400 sm:h-24 sm:w-32" aria-hidden="true">{w.es.charAt(0).toUpperCase()}</span>
    )
  }
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-x-2">
      {hasPage(w) ? <a href={wordUrl(w)} class="text-lg font-bold text-slate-900 hover:text-blue-700">{w.es}</a> : <span class="text-lg font-bold text-slate-900">{w.es}</span>}
      <button type="button" data-say={w.es} class="rounded-lg px-1 text-base leading-none hover:bg-slate-100" aria-label={`Произнести ${w.es}`}>🔊</button>
      {w.q > 0 && <span class="rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700">в {w.q} вопр.</span>}
    </div>
    <p class="font-medium text-blue-700">{w.ru}</p>
    {w.d && <p class="mt-1 line-clamp-2 text-sm text-slate-500">{w.d}</p>}
  </div>
</li>
