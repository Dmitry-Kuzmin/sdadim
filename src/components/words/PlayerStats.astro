---
/** Панель игрока: ранг, опыт, серия дней, цель дня, выучено слов. Заполняет Trainer.astro из localStorage. */
import { DAILY_GOAL, RANKS } from "./engine";
---

<div class="grid grid-cols-2 gap-3 md:grid-cols-4">
  <div class="col-span-2 rounded-2xl border border-slate-200 p-4">
    <div class="flex items-center gap-3">
      <span class="grid h-12 w-12 place-items-center rounded-xl bg-blue-50 text-2xl" data-ws="rank-emoji">{RANKS[0].emoji}</span>
      <div class="min-w-0 flex-1">
        <p class="text-xs font-medium text-slate-500">Ваш ранг</p>
        <p class="truncate font-bold text-slate-900" data-ws="rank">{RANKS[0].name}</p>
      </div>
      <p class="text-right text-sm font-bold tabular-nums text-slate-900"><span data-ws="xp">0</span> XP</p>
    </div>
    <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100"><i class="block h-full w-0 rounded-full bg-blue-600 transition-all duration-700" data-ws-bar="rank"></i></div>
    <p class="mt-1.5 text-xs text-slate-500" data-ws="rank-next">до «{RANKS[1].name}» — {RANKS[1].xp} XP</p>
  </div>
  <div class="rounded-2xl border border-slate-200 p-4">
    <p class="text-xs font-medium text-slate-500">Цель дня</p>
    <p class="mt-1 font-bold tabular-nums text-slate-900" data-ws="goal">0 / {DAILY_GOAL} XP</p>
    <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100"><i class="block h-full w-0 rounded-full bg-orange-500 transition-all duration-700" data-ws-bar="goal"></i></div>
  </div>
  <div class="grid grid-cols-2 gap-3 md:grid-cols-1">
    <div class="rounded-2xl border border-slate-200 px-4 py-2.5">
      <p class="text-xs font-medium text-slate-500">Дней подряд</p>
      <p class="font-bold tabular-nums text-slate-900">🔥 <span data-ws="streak">0</span></p>
    </div>
    <div class="rounded-2xl border border-slate-200 px-4 py-2.5">
      <p class="text-xs font-medium text-slate-500">Выучено слов</p>
      <p class="font-bold tabular-nums text-slate-900">✅ <span data-ws="learned">0</span></p>
    </div>
  </div>
</div>
